# Tooling
node_modules/
dist/
.DS_Store

# Source renders and CAD exports. No page references these (the site uses the web/
# and store/ WebP exports), and the Gen2 renders alone are ~200 MB. They stay on disk.
assets/productImages/**/*.png
assets/productImages/**/*.PNG

# Frame sheets from tools/perf/reel.mjs (regenerate with npm run reel)
tools/perf/reel/

# Crops from tools/check/hand.mjs (regenerate with npm run check:hand)
tools/check/out/

# The font sources tools/source/fonts.py downloads (the woff2 it writes are committed)
tools/source/.fonts-cache/

# The list of lines to translate, made fresh by node tools/i18n.mjs extract
i18n/source.json
